#!/usr/bin/env groovy

pipeline {
    agent any
    tools {
        maven 'maven-3.9'
    }
    stages {
        stage('increment version') {
            steps {
                script {
                    echo 'incrementing app version...'
                    sh 'mvn build-helper:parse-version versions:set \
                        -DnewVersion=\\\${parsedVersion.majorVersion}.\\\${parsedVersion.minorVersion}.\\\${parsedVersion.nextIncrementalVersion} \
                        versions:commit'
                    def matcher = readFile('pom.xml') =~ '<version>(.+)</version>'
                    def version = matcher[0][1]
                    env.IMAGE_NAME = "$version-$BUILD_NUMBER"
                }
            }
        }
        stage('building app') {
            steps {
                script {
                    echo "building the application..."
                    sh 'mvn clean package'
                }
            }
        }
        stage('build image') {
            steps {
                script {
                    echo "building the docker image..."
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-repo', passwordVariable: 'PASS', usernameVariable: 'USER')]) {
                        sh "docker build -t malware4/java-maven-app:${IMAGE_NAME} ."
                        sh "echo $PASS | docker login -u $USER --password-stdin"
                        sh "docker push malware4/java-maven-app:${IMAGE_NAME}"
                    }
                }
            }
        }
        stage('deploy') {
            steps {
                script {
                    echo 'deploying docker image to EC2...'
                }
            }
        }
stage('commit version update') {
  steps {
    script {
      withCredentials([usernamePassword(credentialsId: 'github-credentials',
                                        usernameVariable: 'GIT_USER',
                                        passwordVariable: 'GIT_TOKEN')]) {
        sh '''
          set -e

          git config --global user.email "jenkins@example.com"
          git config --global user.name "jenkins"

          # Clean remote URL (no secrets in it)
          git remote set-url origin https://github.com/nickzerze/java-maven-app.git

          # Askpass helper (no URL-embedded token)
          cat > /tmp/askpass.sh <<'EOF'
#!/bin/sh
case "$1" in
  *Username*) echo "$GIT_USER" ;;
  *Password*) echo "$GIT_TOKEN" ;;
esac
EOF
          chmod +x /tmp/askpass.sh
          export GIT_ASKPASS=/tmp/askpass.sh
          export GIT_TERMINAL_PROMPT=0

          git add .
          git commit -m "ci: version bump" || echo "Nothing to commit"
          git push origin HEAD:jenkins-jobs
        '''
      }
    }
  }
}

    }
}
